# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Third-party data fetched at run time (licences differ; see docs/PHYSICS.md §14)
reference/data/cache/

# Build output
bin/
obj/
*.user

# Reference model render caches and scratch scripts
reference/output/*.npz
reference/output/render_log.txt
reference/scratch/

# Unity project generated folders and the synced core copy
unity/RealAirglowShaders/Library/
unity/RealAirglowShaders/Temp/
unity/RealAirglowShaders/Logs/
unity/RealAirglowShaders/obj/
unity/RealAirglowShaders/Build/
unity/RealAirglowShaders/UserSettings/
unity/RealAirglowShaders/Assets/Core/
unity/RealAirglowShaders/Assets/Core.meta
unity/RealAirglowShaders/*.log
unity/RealAirglowShaders/*.csproj
unity/RealAirglowShaders/*.sln

# Harness outputs (regenerated by tools/build_shaders.sh)
reference/output/harness/

# Runtime settings written by the plugin
GameData/RealAirglow/PluginData/

# .NET test output
tests/**/bin/
tests/**/obj/

# Build outputs placed into GameData by the builds (packaged for releases, not committed)
GameData/RealAirglow/Plugins/
GameData/RealAirglow/Shaders/

# Release zips (tools/package_release.sh)
release/
